	)
	(text_box "'317 generates a stable, but noisy voltage.\nThe capacitance multiplier then filters the noise.\nThis arrangement provides worse tempco than a voltage regulator,\nbut noise performance should be superior - and this RIAA circuit\nhas poor PSRR, so power supply noise will couple into the output.\nThe goal is to achieve 9 V at the output.\n\nThe '317 might be omitted. R111 provides opportunity to do so.\nZener diodes provide the stabilisation in such scenario.\nTL431 can be used instead of zener diodes. Do not populate both options."
		(exclude_from_sim no)
		(at 171.45 17.78 0)
		(size 78.74 21.59)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2bf248f2-f05f-4eb5-926c-0916e95b0238")
	)
	(text_box "D105 protects against both ESD events and reverse polarity connection\nF101 should be rated for 60 V!\n"
		(exclude_from_sim no)
		(at 34.29 31.75 0)
		(size 44.45 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
